CREATE TABLE employees(
    id INTEGER PRIMARY KEY,
    name TEXT,
    department TEXT,
    salary INTEGER
);

INSERT INTO employees(id, name, department, salary) # To INSERT data into the table.
VALUES (3,'Vikram', 'Finance', 45000);

SELECT * FROM employees; # to view all data in the table

SELECT name, department FROM employees; # to select specific columns

SELECT * FROM employees
WHERE salary > 40000;   # to check where condition applies in the table

UPDATE employees
SET salary = 65000
WHERE id = 1; #update from key is the best

UPDATE employees
SET salary = 40000
WHERE name = 'Anita';

DELETE FROM employees; # this will DELETE all the table.

DELETE FROM employees
WHERE name = 'vikram' #only delete specific data from the table.